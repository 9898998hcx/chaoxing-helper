# Local SQLite. Relative to prisma/schema.prisma; production uses PostgreSQL schema.
DATABASE_URL=file:./dev.db
APP_ORIGIN=http://127.0.0.1:3000
PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
NODE_ENV=development
# Empty or memory:// => single-process in-memory rate limits; real Redis needed for crawler.
REDIS_URL=memory://
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 32-byte hex key for AES-256-GCM encryption of user DeepSeek keys.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
USER_SECRET_ENCRYPTION_KEY=
# Optional server fallback Key. Users may instead configure their own Key in the AI panel (BYOK).
# Server-only. Never use NEXT_PUBLIC_DEEPSEEK_API_KEY or commit a real Key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=20000
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS=1800
AI_DAILY_LIMIT=3
AI_REQUESTS_PER_MINUTE=5
AI_MONTHLY_TOKEN_LIMIT=1000000
AI_BUDGET_WARNING_PERCENT=80
PDF_TIMEOUT_MS=20000
PDF_MAX_BYTES=10485760
PDF_MAX_INPUT_BYTES=200000
PDF_CONCURRENCY=2
# Optional explicit browser executable or chromium channel.
PLAYWRIGHT_EXECUTABLE_PATH=
PDF_FONT_PATH=
# Optional private PDF archive; default false keeps PDF ephemeral.
S3_ARCHIVE_PDFS=false
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Both global switch and source authorization must be explicitly enabled.
CRAWLER_ENABLED=false
